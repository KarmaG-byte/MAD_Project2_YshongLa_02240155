rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function currentUser() { return get(userPath(request.auth.uid)); }
    function isVerifiedCustomer() {
      return signedIn()
        && currentUser().data.role == 'customer'
        && currentUser().data.phoneVerified == true;
    }
    function isVerifiedShopkeeper() {
      return signedIn()
        && currentUser().data.role == 'shopkeeper'
        && currentUser().data.phoneVerified == true
        && currentUser().data.cidNumber is string
        && currentUser().data.cidNumber.size() > 0
        && currentUser().data.cidImageUri is string
        && currentUser().data.cidImageUri.size() > 0;
    }
    function v2Product(data) { return data.get('schemaVersion', 1) == 2; }
    function v2Booking(data) { return data.get('schemaVersion', 1) == 2; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function productPath(pid) { return /databases/$(database)/documents/products/$(pid); }
    function bookingPath(bid) { return /databases/$(database)/documents/bookings/$(bid); }
    function seller(uid) {
      return isSelf(uid) && exists(userPath(uid))
        && get(userPath(uid)).data.role in ['shopkeeper', 'seller'];
    }
    function validProduct(data) {
      return data.sellerId is string && data.name is string
        && data.price is number && data.price > 0
        && data.stock is int && data.stock >= 0
        && data.active is bool;
    }
    function validShop(data) {
      return data.name is string && data.openTime is string
        && data.closeTime is string && data.closedDays is string;
    }
    function productReservation(pid) {
      let bid = request.resource.data.lastBookingId;
      let bp = bookingPath(bid);
      return signedIn()
        && v2Product(resource.data)
        && v2Product(request.resource.data)
        && bid is string
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stock', 'lastBookingId', 'updatedAt'])
        && resource.data.stock is int && resource.data.stock > 0
        && request.resource.data.stock == resource.data.stock - 1
        && !exists(bp)
        && getAfter(bp).data.schemaVersion == 2
        && getAfter(bp).data.productId == pid
        && getAfter(bp).data.customerId == request.auth.uid
        && getAfter(bp).data.sellerId == resource.data.sellerId
        && getAfter(bp).data.status == 'pending'
        && getAfter(bp).data.quantity == 1;
    }
    function productRestock(pid) {
      let bid = request.resource.data.lastBookingId;
      let bp = bookingPath(bid);
      return signedIn()
        && v2Product(resource.data)
        && v2Product(request.resource.data)
        && bid is string && exists(bp)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stock', 'lastBookingId', 'updatedAt'])
        && resource.data.stock is int
        && request.resource.data.stock == resource.data.stock + 1
        && get(bp).data.schemaVersion == 2
        && get(bp).data.productId == pid
        && get(bp).data.status == 'pending'
        && ((request.auth.uid == get(bp).data.customerId
             && getAfter(bp).data.status == 'cancelled')
          || (request.auth.uid == get(bp).data.sellerId
             && getAfter(bp).data.status == 'rejected'));
    }
    function bookingCreatedCorrectly(bid) {
      let data = request.resource.data;
      let pp = productPath(data.productId);
      return signedIn()
        && data.keys().hasOnly([
          'schemaVersion', 'productId', 'productName', 'customerId', 'customerName',
          'sellerId', 'sellerName', 'quantity', 'unitPrice',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.schemaVersion == 2
        && data.customerId == request.auth.uid
        && data.quantity == 1 && data.status == 'pending'
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && exists(pp)
        && v2Product(get(pp).data)
        && get(pp).data.active == true
        && get(pp).data.stock is int && get(pp).data.stock >= 1
        && data.sellerId == get(pp).data.sellerId
        && data.unitPrice == get(pp).data.price
        && getAfter(pp).data.stock == get(pp).data.stock - 1
        && getAfter(pp).data.lastBookingId == bid;
    }
    function bookingRestocked(bid) {
      let pp = productPath(resource.data.productId);
      return exists(pp)
        && v2Product(get(pp).data)
        && getAfter(pp).data.stock == get(pp).data.stock + 1
        && getAfter(pp).data.lastBookingId == bid;
    }
    function validBookingTransition(bid) {
      return signedIn()
        && v2Booking(resource.data) && v2Booking(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          (request.auth.uid == resource.data.customerId
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && bookingRestocked(bid))
          || (request.auth.uid == resource.data.sellerId
            && ((resource.data.status == 'pending'
                   && request.resource.data.status == 'confirmed')
                || (resource.data.status == 'confirmed'
                   && request.resource.data.status == 'collected')
                || (resource.data.status == 'pending'
                   && request.resource.data.status == 'rejected'
                   && bookingRestocked(bid))))
        );
    }

    function validShopReview(reviewId) {
      let data = request.resource.data;
      let booking = bookingPath(data.bookingId);
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == 'customer'
        && data.keys().hasAll([
          'shopId', 'customerId', 'customerName', 'bookingId',
          'rating', 'comment', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'shopId', 'customerId', 'customerName', 'bookingId',
          'rating', 'comment', 'createdAt', 'updatedAt'
        ])
        && data.shopId is string
        && data.customerId == request.auth.uid
        && reviewId == data.shopId + '_' + request.auth.uid
        && data.shopId != request.auth.uid
        && exists(/databases/$(database)/documents/shops/$(data.shopId))
        && data.customerName == get(userPath(request.auth.uid)).data.name
        && data.bookingId is string
        && exists(booking)
        && get(booking).data.customerId == request.auth.uid
        && get(booking).data.sellerId == data.shopId
        && get(booking).data.status == 'collected'
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.comment is string
        && data.comment.size() >= 10 && data.comment.size() <= 500;
    }
    match /shopReviews/{reviewId} {
      // Public shop feedback; customers need not be signed in to read it.
      allow get, list: if true;
      // Only verified customers with a collected reservation may review.
      // Document ID = shopId + '_' + customerUid, so one review per shop/customer.
      allow create: if validShopReview(reviewId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if validShopReview(reviewId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['rating', 'comment', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /users/{uid} {
      // TshongLa 1 profiles may not contain a uid field. Preserve owner reads
      // and updates while the existing app performs phone/CID verification.
      allow create, get, update: if isSelf(uid);
      allow list, delete: if false;
    }
    match /shops/{uid} {
      allow read: if true; // This collection contains only public business details.
      allow create, update: if seller(uid) && validShop(request.resource.data);
      allow delete: if false;
    }
    match /products/{pid} {
      allow read: if signedIn();
      allow create: if (
        !v2Product(request.resource.data)
        && isVerifiedShopkeeper()
        && request.resource.data.sellerId == request.auth.uid
      ) || (
        v2Product(request.resource.data)
        && seller(request.auth.uid)
        && request.resource.data.sellerId == request.auth.uid
        && validProduct(request.resource.data)
      );
      allow update: if (
        // Original TshongLa 1 documents keep their own verification model.
        !v2Product(resource.data) && !v2Product(request.resource.data)
        && signedIn() && (
          resource.data.sellerId == request.auth.uid
          || (isVerifiedCustomer()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
              && request.resource.data.stock >= 0
              && request.resource.data.stock < resource.data.stock)
          || (isVerifiedCustomer()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['rating', 'ratingCount', 'ratingSum', 'updatedAt']))
        )
      ) || (
        // TshongLa 2 listings are editable only by the matching shopkeeper.
        v2Product(resource.data) && v2Product(request.resource.data)
        && seller(request.auth.uid)
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId
        && validProduct(request.resource.data)
      ) || productReservation(pid) || productRestock(pid);
      allow delete: if signedIn()
        && !v2Product(resource.data)
        && resource.data.sellerId == request.auth.uid;
    }
    match /bookings/{bid} {
      allow get, list: if signedIn()
        && (resource.data.customerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid);
      allow create: if (
        // Project I verified customers and legacy capitalized booking status.
        !v2Booking(request.resource.data)
        && isVerifiedCustomer()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'Reserved'
        && request.resource.data.quantity > 0
      ) || bookingCreatedCorrectly(bid);
      allow update: if (
        !v2Booking(resource.data) && !v2Booking(request.resource.data)
        && signedIn()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in [
          'Reserved', 'Ready for pickup', 'Collected', 'Cancelled'
        ]
      ) || validBookingTransition(bid);
      allow delete: if false;
    }
    match /reviews/{rid} {
      allow read: if signedIn();
      allow create: if isVerifiedCustomer()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.verifiedPurchase == true
        && request.resource.data.productRating >= 1
        && request.resource.data.productRating <= 5
        && request.resource.data.businessRating >= 1
        && request.resource.data.businessRating <= 5
        && exists(bookingPath(request.resource.data.bookingId))
        && get(bookingPath(request.resource.data.bookingId)).data.customerId == request.auth.uid
        && get(bookingPath(request.resource.data.bookingId)).data.productId == request.resource.data.productId
        && get(bookingPath(request.resource.data.bookingId)).data.status == 'Collected';
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
